# Copy to backend/.env and fill in real values. Never commit .env.

# Secret used to sign JWTs (required). Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts stored credentials at rest (required). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Public base URL advertised by /api/health (used by deployments behind proxies)
PUBLIC_URL=

# Comma-separated origins allowed by CORS (default: http://localhost:8000,http://localhost:5173)
# Production MUST NOT use "*" when credentials are involved (refused at startup).
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Bind address/port for `python -m app.serve`
HOST=127.0.0.1
PORT=8000

# Serve the built frontend from the same port (default: true)
SERVE_FRONTEND=true

# --- Database (PostgreSQL + pgvector) ---
# Docker Compose default is pgvector/pgvector:16 with user/db `automate`.
# Override for external PostgreSQL or production secrets.
# DATABASE_URL=postgresql://automate:CHANGE_ME@postgres:5432/automate
POSTGRES_PASSWORD=automate

# --- Redis (queue + throttling) ---
# Docker Compose binds Redis to 127.0.0.1 only. Set a password for production;
# when REDIS_PASSWORD is set the server requires it and REDIS_URL must carry it.
# REDIS_PASSWORD=change-me-in-production
# REDIS_URL=redis://:change-me-in-production@redis:6379/0
# For local dev without a password the default below works:
# REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Job queue & workers (Phase 15):
# QUEUE_BACKEND=db            # "db" (jobs table) or "redis" (+ REDIS_URL)
# REDIS_URL=redis://localhost:6379/0
# QUEUE_EMBEDDED_CONSUMER=true  # false: API only enqueues; run
#                               # `python -m app.queue.worker` separately
QUEUE_MAX_ATTEMPTS=10
QUEUE_RETRY_BACKOFF_BASE_S=2
QUEUE_RETRY_BACKOFF_MAX_S=300
REDIS_JOB_META_TTL_S=86400

# --- Object storage (S3-compatible, Phase 19) ---
# `local` (default) stores bytes under OBJECT_STORE_LOCAL_PATH on the
# app volume. `s3` uses any S3-compatible provider (AWS, MinIO, R2…).
# MinIO for local S3 dev:  docker compose --profile s3 up -d
OBJECT_STORE_BACKEND=local
OBJECT_STORE_LOCAL_PATH=./data/objects
# For S3 / MinIO:
# OBJECT_STORE_BUCKET=my-bucket
# OBJECT_STORE_ENDPOINT=http://localhost:9000
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_ACCESS_KEY=minioadmin
# OBJECT_STORE_SECRET_KEY=minioadmin

# --- Vector storage (PostgreSQL + pgvector) ---
# Default backend is `pgvector`. No extra Python deps needed.
# VECTOR_STORE=pgvector

# Salesforce "Connect Salesforce" OAuth (server-side Connected App config).
# End users authorize with their OWN Salesforce account; these values are
# never exposed to the frontend.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# MUST exactly match the Callback URL registered in the Connected App
# (e.g. http://localhost:8000/api/auth/salesforce/callback).
SALESFORCE_REDIRECT_URI=
# Authorization server base (login.salesforce.com for prod, test.salesforce.com
# for sandboxes, or the org's custom domain for Dev/EE orgs).
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v63.0
SALESFORCE_SCOPE=refresh_token full api
OAUTH_STATE_TTL_SECONDS=600

# Live Salesforce acceptance tests (Phase 9) — pytest, NOT used by the app.
# Enable with SF_LIVE=1 plus the four credential vars; sandboxes set
# SF_LIVE_LOGIN_URL=https://test.salesforce.com. Optional extras:
#   SF_LIVE_EXTERNAL_ID_FIELD  (upsert round trip)
#   SF_LIVE_BULK=1             (Bulk API insert/delete round trip)
# Run: pytest tests/integration/test_salesforce_live.py -v
# SF_LIVE=
# SF_LIVE_CLIENT_ID=
# SF_LIVE_CLIENT_SECRET=
# SF_LIVE_USERNAME=
# SF_LIVE_PASSWORD=
# SF_LIVE_LOGIN_URL=https://login.salesforce.com
# SF_LIVE_API_VERSION=v63.0
