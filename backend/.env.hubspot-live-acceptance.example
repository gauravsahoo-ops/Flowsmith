# Live HubSpot acceptance credentials.
# Copy this file to backend/.env.hubspot-live-acceptance and fill in real
# values. NEVER commit backend/.env.hubspot-live-acceptance.
#
# Preferred: a private-app token with CRM object scopes. Custom-object
# discovery additionally needs crm.schemas.read.
HUBSPOT_ACCEPTANCE_PRIVATE_TOKEN=
#
# Alternative: OAuth refresh token from the "Connect HubSpot" flow. When
# using this, also provide the app client id/secret (or set
# HUBSPOT_CLIENT_ID / HUBSPOT_CLIENT_SECRET in the server environment).
HUBSPOT_ACCEPTANCE_REFRESH_TOKEN=
HUBSPOT_ACCEPTANCE_CLIENT_ID=
HUBSPOT_ACCEPTANCE_CLIENT_SECRET=
HUBSPOT_ACCEPTANCE_HUB_ID=
#
# Optional: a custom object API name that exists in the portal (for example
# "cars" or "2-12345678"). When set, the acceptance run also lists one record
# from that object through the full workflow stack. Leave empty to test
# standard-object discovery only; the script will report the custom-object
# check as SKIPPED rather than PASS.
HUBSPOT_ACCEPTANCE_OBJECT=
#
# Local Flowsmith acceptance account (created in the temporary test DB).
HUBSPOT_ACCEPTANCE_APP_EMAIL=hubspot-acceptance@example.com
HUBSPOT_ACCEPTANCE_APP_PASSWORD=Acceptance-P@ssw0rd1
