# Live Salesforce acceptance credentials (Phase 20).
# Copy this file to backend/.env.live-acceptance and fill in real values.
# NEVER commit .env.live-acceptance. The acceptance script reads it and
# never prints the values.
#
# Two auth methods are supported; provide ONE:
#   A) refresh-token grant (recommended, no password needed):
#      SF_ACCEPTANCE_CLIENT_ID + SF_ACCEPTANCE_CLIENT_SECRET +
#      SF_ACCEPTANCE_REFRESH_TOKEN
#   B) username-password grant:
#      SF_ACCEPTANCE_CLIENT_ID + SF_ACCEPTANCE_CLIENT_SECRET +
#      SF_ACCEPTANCE_USERNAME + SF_ACCEPTANCE_PASSWORD
#      (password may include the API security token appended)

# https://login.salesforce.com or https://<yourdomain>.my.salesforce.com
SF_ACCEPTANCE_INSTANCE_URL=https://login.salesforce.com

# Connected App consumer key/secret
SF_ACCEPTANCE_CLIENT_ID=
SF_ACCEPTANCE_CLIENT_SECRET=

# Refresh token from the authorization-code flow (one-time: run
#   curl "https://login.salesforce.com/services/oauth2/authorize?response_type=code&client_id=<CLIENT_ID>&redirect_uri=<REDIRECT_URI>&scope=api%20refresh_token"
# in a browser, then exchange the code:
#   curl -X POST https://login.salesforce.com/services/oauth2/token -d "grant_type=authorization_code&client_id=<CLIENT_ID>&client_secret=<CLIENT_SECRET>&redirect_uri=<REDIRECT_URI>&code=<CODE>"
# and copy the refresh_token value from the JSON response)
SF_ACCEPTANCE_REFRESH_TOKEN=

# Org user for the username-password grant (optional when refresh_token is set)
SF_ACCEPTANCE_USERNAME=
SF_ACCEPTANCE_PASSWORD=

# Optional: API version (default v63.0)
# SF_ACCEPTANCE_API_VERSION=v63.0