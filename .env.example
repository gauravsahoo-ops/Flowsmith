# Root .env — consumed by docker-compose.yml
# Copy to .env and adjust for your environment. Never commit .env.

# --- PostgreSQL (pgvector) ---
# Required. Use a long random value; leave blank to force a startup error
# rather than shipping a known default password.
POSTGRES_PASSWORD=

# --- Redis ---
# Leave empty for passwordless local dev. Set for production.
REDIS_PASSWORD=

# --- Network Binding & Reverse Proxy ---
# Loopback by default (127.0.0.1) so local dev and default deployments are never
# exposed publicly without a reverse proxy. Production deployments should keep
# APP_BIND=127.0.0.1 and front with Caddy / NGINX / ALB with TLS termination.
APP_BIND=127.0.0.1
APP_PORT=8000

# --- Application secrets (backend reads from backend/.env) ---
# JWT_SECRET=
# CREDENTIALS_ENCRYPTION_KEY=
# PUBLIC_URL=https://your-domain.example

# --- Registration policy (backend) ---
# open | invite | closed. Docker production defaults to closed.
# REGISTRATION_MODE=closed
# REGISTRATION_INVITE_CODE=
# Required to claim the first admin on a fresh production instance.
# Generate with: openssl rand -hex 32
# REGISTRATION_BOOTSTRAP_TOKEN=

# --- Trusted reverse proxies (X-Forwarded-For) ---
# TRUSTED_PROXIES=127.0.0.1,::1

# --- Grafana (monitoring profile) ---
# REQUIRED by docker-compose.yml even when monitoring is disabled — compose
# refuses to start without them (no default admin/admin credentials allowed).
# Change the password before enabling the monitoring profile.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-strong-password
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090

# --- SMTP / Email Delivery (Password Resets & Notifications) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# MAIL_FROM="Flowsmith <noreply@yourdomain.com>"
# SMTP_USE_TLS=false
# SMTP_STARTTLS=true

# --- Salesforce Connected App (OAuth & Token Renewal) ---
# Required for "Connect Salesforce" OAuth popup and background token renewal.
# Values come from Salesforce Setup -> App Manager -> Connected App -> View Consumer Details.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_REDIRECT_URI=https://flowsmith.dev.idslogic.net/api/auth/salesforce/callback
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SALESFORCE_API_VERSION=v63.0
# SALESFORCE_SCOPES=refresh_token full api

# --- Microsoft Dynamics 365 CRM (OAuth2 & Azure Service Principal) ---
# Values come from Microsoft Entra ID (Azure Portal) -> App registrations
# DYNAMICS_CRM_CLIENT_ID=
# DYNAMICS_CRM_CLIENT_SECRET=
# DYNAMICS_CRM_REDIRECT_URI=https://flowsmith.dev.idslogic.net/api/auth/dynamics_crm/callback
# DYNAMICS_CRM_TENANT_ID=common
# DYNAMICS_CRM_INSTANCE_URL=https://myorg.crm.dynamics.com
# DYNAMICS_CRM_SCOPES=offline_access https://admin.services.crm.dynamics.com/user_impersonation

# --- HubSpot Connected App (OAuth2) ---
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=https://flowsmith.dev.idslogic.net/api/auth/hubspot/callback
# HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write crm.objects.deals.read crm.objects.deals.write

# --- Google Workspace & APIs (Calendar, Sheets, Gmail, Drive) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://flowsmith.dev.idslogic.net/api/auth/google/callback

# --- Enterprise Single Sign-On (SSO) ---
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
# SSO_GITHUB_CLIENT_ID=
# SSO_GITHUB_CLIENT_SECRET=
# SSO_OIDC_ISSUER=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=

# --- SCIM 2.0 user provisioning ---
# SCIM_ENABLED=false
# SCIM_BEARER_TOKEN=
# SCIM_DEFAULT_ORGANIZATION_ID=
# SCIM_DEFAULT_WORKSPACE_ID=
# SCIM groups become private workspaces in this organization. If the owner
# email is omitted, the first active administrator is used.
# SCIM_GROUP_ORGANIZATION_ID=
# SCIM_GROUP_OWNER_EMAIL=

# --- LDAP authentication ---
# Local passwords are checked first; LDAP is a fallback. Use ldaps:// or
# LDAP_START_TLS=true in production. The group role map is a JSON object.
# LDAP_ENABLED=false
# LDAP_SERVER_URL=ldaps://ldap.example.com
# LDAP_START_TLS=false
# LDAP_TLS_VERIFY=true
# LDAP_CA_CERT_FILE=
# LDAP_BIND_DN=cn=svc-flowsmith,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_USER_SEARCH_FILTER=(uid={username})
# LDAP_USER_EMAIL_ATTRIBUTE=mail
# LDAP_USER_DISPLAY_ATTRIBUTE=displayName
# LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
# LDAP_GROUP_SEARCH_FILTER=(member={user_dn})
# LDAP_GROUP_ATTRIBUTE=cn
# LDAP_GROUP_ROLE_MAP={"platform-admins":"admin"}
# Optional group -> workspace memberships (values may be a workspace ID or
# {"workspace_id": "...", "role": "member|admin", "permission": "view|edit|admin"}):
# LDAP_GROUP_WORKSPACE_MAP={"platform-admins":["ws_xxx"],"employees":[{"workspace_id":"ws_yyy","permission":"view"}]}
# Optional group -> organization memberships:
# LDAP_GROUP_ORG_MAP={"platform-admins":[{"organization_id":"org_xxx","role":"admin","permission":"admin"}]}
# LDAP_DEFAULT_ROLE=member
# LDAP_JIT_PROVISIONING=true
# LDAP_DEFAULT_ORGANIZATION_ID=
# LDAP_DEFAULT_WORKSPACE_ID=
# LDAP_CONNECT_TIMEOUT_SECONDS=5
# LDAP_RECEIVE_TIMEOUT_SECONDS=10
# Background refresh of stored LDAP groups/roles/workspace+org access.
# LDAP_SYNC_ENABLED=false
# LDAP_SYNC_INTERVAL_SECONDS=900

# --- WebAuthn/passkeys ---
# Disabled by default. RP_ID is the registrable domain (no scheme), ORIGIN is
# the exact browser origin. Both must match the deployment.
# WEBAUTHN_ENABLED=false
# WEBAUTHN_RP_ID=flowsmith.example.com
# WEBAUTHN_RP_NAME=Flowsmith
# WEBAUTHN_ORIGIN=https://flowsmith.example.com
# WEBAUTHN_REQUIRE_UV=true
# WEBAUTHN_TIMEOUT_MS=60000
# Optional hardware attestation policy: none | direct | enterprise
# WEBAUTHN_ATTESTATION=none
# WEBAUTHN_ATTESTATION_ROOTS_FILE=
# WEBAUTHN_ALLOWED_AAGUIDS=
# WEBAUTHN_ALLOWED_FORMATS=packed,tpm,fido-u2f

# --- Connector pack signing ---
# Remote manifest URLs always require a valid Ed25519 signature.
# Set this true to require signatures for inline admin-supplied manifests too.
# CONNECTOR_PACK_REQUIRE_SIGNATURE=false
# JSON map of trusted key IDs to PEM or base64 raw Ed25519 public keys.
# CONNECTOR_PACK_TRUSTED_KEYS={"release-2026":"MCowBQYDK2VwAyEA..."}
# Comma-separated signing key IDs to reject after key compromise/rotation.
# CONNECTOR_PACK_REVOKED_KEYS=release-2025

# --- Native SAML 2.0 Web SSO ---
# SAML_ENABLED=false
# SAML_DISPLAY_NAME=SAML 2.0
# IdP metadata: use a public HTTPS URL, or paste XML for air-gapped installs.
# SAML_IDP_METADATA_URL=
# SAML_IDP_METADATA_XML=
# Optional pins / overrides:
# SAML_IDP_ENTITY_ID=
# SAML_IDP_X509_CERT=
# SAML_SP_ENTITY_ID=
# SAML_SP_ACS_URL=
# Optional SP request signing (set both) / assertion decryption (private key):
# SAML_SP_X509_CERT=
# SAML_SP_PRIVATE_KEY=
# SAML_JIT_PROVISIONING=true
# SAML_DEFAULT_ROLE=member
# SAML_ROLE_ATTRIBUTE=role
# Optional IdP group-claim role mapping (JSON object):
# SAML_GROUP_ATTRIBUTE=groups
# SAML_GROUP_ROLE_MAP={"platform-admins":"admin"}
# SAML_DEFAULT_ORGANIZATION_ID=
# SAML_DEFAULT_WORKSPACE_ID=
# SAML_ALLOW_IDP_INITIATED=false
# SAML_CLOCK_SKEW_SECONDS=120
# SAML_METADATA_CACHE_SECONDS=300


