# Root .env — consumed by docker-compose.yml
# Copy to .env and adjust for your environment. Never commit .env.

# --- PostgreSQL (pgvector) ---
POSTGRES_PASSWORD=automate

# --- Redis ---
# Leave empty for passwordless local dev. Set for production.
REDIS_PASSWORD=

# --- Application secrets (backend reads from backend/.env) ---
# JWT_SECRET=
# CREDENTIALS_ENCRYPTION_KEY=

# --- SMTP / Email Delivery (Password Resets & Notifications) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# MAIL_FROM="Flowsmith <noreply@yourdomain.com>"
# SMTP_USE_TLS=false
# SMTP_STARTTLS=true
